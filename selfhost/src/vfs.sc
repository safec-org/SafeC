    return
    "#pragma once\n"
    "// SafeC Standard Library — Vec<T> (dynamic array)\n"
    "//\n"
    "//   struct Vec<int> v = std::Vec::new();       // T inferred from the target\n"
    "//   v.push(3);\n"
    "//   match (v.get(0UL)) { case null: ... case some(x): *x = 4; }\n"
    "//   ?int last = v.pop();\n"
    "//   v.free();\n"
    "//\n"
    "// Elements are stored by value in one contiguous heap buffer. Element access\n"
    "// hands out '?&T' (null when out of range) — a reference into the buffer,\n"
    "// valid until the next call that can reallocate it (push/insert/extend/\n"
    "// reserve/shrink/drop) — the compiler rejects using one after drop().\n"
    "//\n"
    "// A Vec owns its buffer and its elements: it is a Drop type (drop() it, or\n"
    "// move it, on every path), and drop()/clear() drop each element whose type\n"
    "// owns something (String, Vec, ...: see needs_drop). push/insert/set take\n"
    "// the element by value; one they can't store is dropped. clone(), filter(),\n"
    "// extend() and from_arr() copy elements bit for bit, so for an element type\n"
    "// that owns something they would share it: they panic instead (build such\n"
    "// a copy element by element, cloning each).\n"
    "#include <std/mem.h>\n"
    "#include <std/panic.h>\n"
    "#include <std/cmp.h>\n"
    "#include <std/ownership.h>\n"
    "\n"
    "namespace std {\n"
    "\n"
    "generic<T>\n"
    "struct Vec {\n"
    "    ?&heap T      data;  // element buffer; null while cap == 0\n"
    "    unsigned long len;   // element count\n"
    "    unsigned long cap;   // allocated capacity, in elements\n"
    "\n"
    "    // ── Construction ────────────────────────────────────────────────────────\n"
    "    static struct Vec<T> new();                                   // empty, no allocation\n"
    "    static struct Vec<T> with_cap(unsigned long cap);             // empty, room for cap elements\n"
    "    static struct Vec<T> from_slice([]const T items);             // copies the elements\n"
    "\n"
    "    // ── Capacity ────────────────────────────────────────────────────────────\n"
    "    int           reserve(unsigned long new_cap);   // ensure cap >= new_cap; 0 on OOM\n"
    "    void          shrink();                          // cap := len\n"
    "    unsigned long length() const;\n"
    "    unsigned long total_capacity() const;\n"
    "    int           is_empty() const;\n"
    "\n"
    "    // ── Element access ──────────────────────────────────────────────────────\n"
    "    ?&T           get(unsigned long idx) const;      // null if out of range\n"
    "    &T            at(unsigned long idx) const;       // bounds-checked: panics if out of range\n"
    "    []T           as_slice() const;                  // the len elements; valid until the next growth\n"
    "    int           set(unsigned long idx, T value);    // 0 if out of range\n"
    "    ?&T           front();\n"
    "    ?&T           back();\n"
    "\n"
    "    // ── Mutation ────────────────────────────────────────────────────────────\n"
    "    int           push(T value);                      // 0 on OOM\n"
    "    ?T            pop();                              // null if empty\n"
    "    int           insert(unsigned long idx, T value); // idx <= len; shifts right\n"
    "    ?T            remove(unsigned long idx);          // shifts left; null if out of range\n"
    "    void          clear();                            // len := 0, keeps the buffer\n"
    "    int           extend([]const T items);            // append the elements; 0 on OOM\n"
    "\n"
    "    // ── Algorithms ──────────────────────────────────────────────────────────\n"
    "    void          reverse();\n"
    "    void          sort(fn int(const &T, const &T) cmp);  // ascending by cmp (<0, 0, >0); see vec_sort/vec_sort_by for inlined orderings\n"
    "    long long     find(const &T key, fn int(const &T, const &T) cmp) const; // -1 if absent\n"
    "    int           contains(const &T key, fn int(const &T, const &T) cmp) const;\n"
    "    struct Vec<T> clone() const;                      // shallow element copy\n"
    "    void          foreach(fn void(&T, unsigned long) func);\n"
    "    struct Vec<T> filter(fn int(const &T) pred) const;\n"
    "\n"
    "    void          drop();                             // frees the buffer (Drop)\n"
    "    void          free() consume;                     // = drop()\n"
    "};\n"
    "\n"
    "generic<T>\n"
    "struct Vec<T> Vec::new() {\n"
    "    struct Vec<T> v;\n"
    "    v.data = null;\n"
    "    v.len = 0UL;\n"
    "    v.cap = 0UL;\n"
    "    return v;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "struct Vec<T> Vec::with_cap(unsigned long cap) {\n"
    "    struct Vec<T> v = Vec::new();\n"
    "    v.reserve(cap);\n"
    "    return v;\n"
    "}\n"
    "\n"
    "// Copies the elements of 'items'.\n"
    "generic<T>\n"
    "struct Vec<T> Vec::from_slice([]const T items) {\n"
    "    struct Vec<T> v = Vec::with_cap(items.len);\n"
    "    v.extend(items);\n"
    "    return v;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "[]T Vec::as_slice() const {\n"
    "    unsafe { return ((T*)self.data)[0..(self.data.is_null() ? 0UL : self.len)]; }\n"
    "}\n"
    "\n"
    "// kept for std/ml until its refactor moves to the static method\n"
    "generic<T>\n"
    "struct Vec<T> vec_new() { struct Vec<T> v = Vec::new(); return v; }\n"
    "\n"
    "// ── Capacity ──────────────────────────────────────────────────────────────────\n"
    "\n"
    "generic<T>\n"
    "int Vec::reserve(unsigned long new_cap) {\n"
    "    if (new_cap <= self.cap) return 1;\n"
    "    unsigned long bytes = checked_mul_size(new_cap, sizeof(T));\n"
    "    ?&heap T grown = null;\n"
    "    unsafe { grown = (?&heap T)realloc_buf_raw_((unsigned char*)self.data, bytes); }\n"
    "    if (grown.is_null()) return 0;\n"
    "    self.data = grown;\n"
    "    self.cap = new_cap;\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void Vec::shrink() {\n"
    "    if (self.len == self.cap) return;\n"
    "    if (self.len == 0UL) {\n"
    "        unsafe { dealloc(self.data); }\n"
    "        self.data = null;\n"
    "        self.cap = 0UL;\n"
    "        return;\n"
    "    }\n"
    "    ?&heap T smaller = null;\n"
    "    unsafe { smaller = (?&heap T)realloc_buf_raw_((unsigned char*)self.data, self.len * sizeof(T)); }\n"
    "    if (smaller.is_null()) return;   // keep the larger buffer\n"
    "    self.data = smaller;\n"
    "    self.cap = self.len;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "unsigned long Vec::length() const { return self.len; }\n"
    "\n"
    "generic<T>\n"
    "unsigned long Vec::total_capacity() const { return self.cap; }\n"
    "\n"
    "generic<T>\n"
    "int Vec::is_empty() const { return self.len == 0UL; }\n"
    "\n"
    "// ── Element access ────────────────────────────────────────────────────────────\n"
    "\n"
    "generic<T>\n"
    "?&T Vec::get(unsigned long idx) const {\n"
    "    if (idx >= self.len) return null;\n"
    "    unsafe { return (?&T)&self.data[idx]; }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "&T Vec::at(unsigned long idx) const {\n"
    "    if (idx >= self.len) panic_at(\"Vec::at: index out of range\", \"vec.h\", 0);\n"
    "    match (self.data) {\n"
    "        case some(buf): unsafe { return &buf[idx]; }\n"
    "        case null: { }\n"
    "    }\n"
    "    panic_at(\"Vec::at: empty vector\", \"vec.h\", 0);\n"
    "    return self.at(idx);   // unreachable\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int Vec::set(unsigned long idx, T value) {\n"
    "    if (idx >= self.len) { drop(value); return 0; }\n"
    "    unsafe {\n"
    "        drop(self.data[idx]);\n"
    "        self.data[idx] = value;\n"
    "    }\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "?&T Vec::front() { return self.get(0UL); }\n"
    "\n"
    "generic<T>\n"
    "?&T Vec::back() {\n"
    "    if (self.len == 0UL) return null;\n"
    "    return self.get(self.len - 1UL);\n"
    "}\n"
    "\n"
    "// ── Mutation ──────────────────────────────────────────────────────────────────\n"
    "\n"
    "// The growth path is one out-of-line, cold call (realloc_array_raw_) that\n"
    "// returns the new buffer, so a push loop's hot path is a compare, a store\n"
    "// and an increment, with the buffer, length and capacity in registers.\n"
    "generic<T>\n"
    "int Vec::push(T value) {\n"
    "    if (self.len == self.cap) {\n"
    "        unsigned long next = self.cap < 4UL ? 4UL : self.cap * 2UL;\n"
    "        ?&heap T grown = null;\n"
    "        unsafe { grown = (?&heap T)realloc_array_raw_((unsigned char*)self.data, next, sizeof(T)); }\n"
    "        if (grown.is_null()) { drop(value); return 0; }\n"
    "        self.data = grown;\n"
    "        self.cap = next;\n"
    "    }\n"
    "    unsafe { self.data[self.len] = value; }\n"
    "    self.len = self.len + 1UL;\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "?T Vec::pop() {\n"
    "    if (self.len == 0UL) return null;\n"
    "    self.len = self.len - 1UL;\n"
    "    unsafe { return self.data[self.len]; }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int Vec::insert(unsigned long idx, T value) {\n"
    "    if (idx > self.len) { drop(value); return 0; }\n"
    "    if (self.len == self.cap) {\n"
    "        unsigned long next = self.cap < 4UL ? 4UL : self.cap * 2UL;\n"
    "        ?&heap T grown = null;\n"
    "        unsafe { grown = (?&heap T)realloc_array_raw_((unsigned char*)self.data, next, sizeof(T)); }\n"
    "        if (grown.is_null()) { drop(value); return 0; }\n"
    "        self.data = grown;\n"
    "        self.cap = next;\n"
    "    }\n"
    "    unsafe {\n"
    "        unsigned long i = self.len;\n"
    "        while (i > idx) { self.data[i] = self.data[i - 1UL]; i = i - 1UL; }\n"
    "        self.data[idx] = value;\n"
    "    }\n"
    "    self.len = self.len + 1UL;\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "?T Vec::remove(unsigned long idx) {\n"
    "    if (idx >= self.len) return null;\n"
    "    unsafe {\n"
    "        T out = self.data[idx];\n"
    "        unsigned long i = idx;\n"
    "        while (i + 1UL < self.len) { self.data[i] = self.data[i + 1UL]; i = i + 1UL; }\n"
    "        self.len = self.len - 1UL;\n"
    "        return out;\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void Vec::clear() {\n"
    "    if const (needs_drop(T)) {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < self.len) { unsafe { drop(self.data[i]); } i = i + 1UL; }\n"
    "    }\n"
    "    self.len = 0UL;\n"
    "}\n"
    "\n"
    "\n"
    "generic<T>\n"
    "int Vec::extend([]const T items) {\n"
    "    if const (needs_drop(T)) panic_at(\"Vec::extend: the elements own resources; push clones of them instead\", \"vec.h\", 0);\n"
    "    unsigned long count = items.len;\n"
    "    if (count == 0UL) return 1;\n"
    "    if (self.len + count > self.cap) {\n"
    "        unsigned long next = self.cap * 2UL;\n"
    "        if (next < self.len + count) next = self.len + count;\n"
    "        if (!self.reserve(next)) return 0;\n"
    "    }\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < count) { T v = items[i]; self.data[self.len + i] = v; i = i + 1UL; }\n"
    "    }\n"
    "    self.len = self.len + count;\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "// ── Algorithms ────────────────────────────────────────────────────────────────\n"
    "\n"
    "generic<T>\n"
    "void Vec::reverse() {\n"
    "    if (self.len < 2UL) return;\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        unsigned long j = self.len - 1UL;\n"
    "        while (i < j) {\n"
    "            T t = self.data[i];\n"
    "            self.data[i] = self.data[j];\n"
    "            self.data[j] = t;\n"
    "            i = i + 1UL;\n"
    "            j = j - 1UL;\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "// Introsort over [lo, hi): median-of-three quicksort, insertion sort below 16\n"
    "// elements, heapsort once recursion gets too deep (O(n log n) worst case).\n"
    "// Element moves are whole-T copies, not byte loops, and no libc is needed.\n"
    "generic<T, C: Order>\n"
    "void vec_insertion_sort_(&T a, long long lo, long long hi, const &C ord) {\n"
    "    unsafe {\n"
    "        long long i = lo + 1LL;\n"
    "        while (i < hi) {\n"
    "            T x = a[i];\n"
    "            long long j = i - 1LL;\n"
    "            while (j >= lo && ord.cmp(&a[j], &x) > 0) { a[j + 1LL] = a[j]; j = j - 1LL; }\n"
    "            a[j + 1LL] = x;\n"
    "            i = i + 1LL;\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T, C: Order>\n"
    "void vec_sift_down_(&T a, long long lo, long long root, long long n, const &C ord) {\n"
    "    unsafe {\n"
    "        while (1) {\n"
    "            long long child = root * 2LL + 1LL;\n"
    "            if (child >= n) return;\n"
    "            if (child + 1LL < n && ord.cmp(&a[lo + child], &a[lo + child + 1LL]) < 0) child = child + 1LL;\n"
    "            if (ord.cmp(&a[lo + root], &a[lo + child]) >= 0) return;\n"
    "            T t = a[lo + root];\n"
    "            a[lo + root] = a[lo + child];\n"
    "            a[lo + child] = t;\n"
    "            root = child;\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T, C: Order>\n"
    "void vec_heap_sort_(&T a, long long lo, long long hi, const &C ord) {\n"
    "    long long n = hi - lo;\n"
    "    long long i = n / 2LL;\n"
    "    while (i > 0LL) { i = i - 1LL; vec_sift_down_(a, lo, i, n, ord); }\n"
    "    long long end = n;\n"
    "    unsafe {\n"
    "        while (end > 1LL) {\n"
    "            end = end - 1LL;\n"
    "            T t = a[lo];\n"
    "            a[lo] = a[lo + end];\n"
    "            a[lo + end] = t;\n"
    "            vec_sift_down_(a, lo, 0LL, end, ord);\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T, C: Order>\n"
    "void vec_introsort_(&T a, long long lo, long long hi, int depth, const &C ord) {\n"
    "    while (hi - lo > 16LL) {\n"
    "        if (depth == 0) { vec_heap_sort_(a, lo, hi, ord); return; }\n"
    "        depth = depth - 1;\n"
    "        unsafe {\n"
    "            long long mid = lo + (hi - lo) / 2LL;\n"
    "            // Median of three into a[mid], then use it as the pivot.\n"
    "            if (ord.cmp(&a[mid], &a[lo]) < 0) { T t = a[mid]; a[mid] = a[lo]; a[lo] = t; }\n"
    "            if (ord.cmp(&a[hi - 1LL], &a[lo]) < 0) { T t = a[hi - 1LL]; a[hi - 1LL] = a[lo]; a[lo] = t; }\n"
    "            if (ord.cmp(&a[hi - 1LL], &a[mid]) < 0) { T t = a[hi - 1LL]; a[hi - 1LL] = a[mid]; a[mid] = t; }\n"
    "            T pivot = a[mid];\n"
    "            long long i = lo;\n"
    "            long long j = hi - 1LL;\n"
    "            while (1) {\n"
    "                while (ord.cmp(&a[i], &pivot) < 0) i = i + 1LL;\n"
    "                while (ord.cmp(&pivot, &a[j]) < 0) j = j - 1LL;\n"
    "                if (i >= j) break;\n"
    "                T t = a[i]; a[i] = a[j]; a[j] = t;\n"
    "                i = i + 1LL;\n"
    "                j = j - 1LL;\n"
    "            }\n"
    "            // Recurse into the smaller half, loop on the larger.\n"
    "            if (j + 1LL - lo < hi - (j + 1LL)) {\n"
    "                vec_introsort_(a, lo, j + 1LL, depth, ord);\n"
    "                lo = j + 1LL;\n"
    "            } else {\n"
    "                vec_introsort_(a, j + 1LL, hi, depth, ord);\n"
    "                hi = j + 1LL;\n"
    "            }\n"
    "        }\n"
    "    }\n"
    "    vec_insertion_sort_(a, lo, hi, ord);\n"
    "}\n"
    "\n"
    "// Sorts by a compile-time ordering (an Order: Less<T>, Greater<T>, or your own\n"
    "// struct with 'int cmp(const &T, const &T) const'): every comparison is a\n"
    "// direct call the optimizer inlines, unlike sort()'s function pointer.\n"
    "generic<T, C: Order>\n"
    "void vec_sort_by(&Vec<T> v, C ord) {\n"
    "    if (v.len < 2UL) return;\n"
    "    int depth = 0;\n"
    "    unsigned long n = v.len;\n"
    "    while (n > 1UL) { n = n >> 1UL; depth = depth + 2; }\n"
    "    match (v.data) {\n"
    "        case null: return;\n"
    "        case some(buf): vec_introsort_(buf, 0LL, (long long)v.len, depth, &ord);\n"
    "    }\n"
    "}\n"
    "\n"
    "// Ascending natural order ('<'), comparisons inlined.\n"
    "generic<T>\n"
    "void vec_sort(&Vec<T> v) {\n"
    "    struct Less<T> ord = Less::new();\n"
    "    vec_sort_by(v, ord);\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void Vec::sort(fn int(const &T, const &T) cmp) {\n"
    "    struct FnOrder<T> ord = FnOrder::of(cmp);\n"
    "    vec_sort_by(self, ord);\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "long long Vec::find(const &T key, fn int(const &T, const &T) cmp) const {\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < self.len) {\n"
    "            if (cmp(&self.data[i], key) == 0) return (long long)i;\n"
    "            i = i + 1UL;\n"
    "        }\n"
    "    }\n"
    "    return -1LL;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int Vec::contains(const &T key, fn int(const &T, const &T) cmp) const {\n"
    "    return self.find(key, cmp) >= 0LL;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "struct Vec<T> Vec::clone() const {\n"
    "    if const (needs_drop(T)) panic_at(\"Vec::clone: the elements own resources; clone them one by one\", \"vec.h\", 0);\n"
    "    struct Vec<T> out = Vec::with_cap(self.len);\n"
    "    match (self.data) {\n"
    "        case null: { }\n"
    "        case some(buf): out.extend(self.as_slice());\n"
    "    }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void Vec::foreach(fn void(&T, unsigned long) func) {\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < self.len) { func(&self.data[i], i); i = i + 1UL; }\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "struct Vec<T> Vec::filter(fn int(const &T) pred) const {\n"
    "    if const (needs_drop(T)) panic_at(\"Vec::filter: the elements own resources; build the result with clones\", \"vec.h\", 0);\n"
    "    struct Vec<T> out = Vec::new();\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < self.len) {\n"
    "            if (pred(&self.data[i])) out.push(self.data[i]);\n"
    "            i = i + 1UL;\n"
    "        }\n"
    "    }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void Vec::free() { self.drop(); }\n"
    "\n"
    "generic<T>\n"
    "void Vec::drop() {\n"
    "    self.clear();\n"
    "    unsafe { dealloc(self.data); }\n"
    "    self.data = null;\n"
    "    self.len = 0UL;\n"
    "    self.cap = 0UL;\n"
    "}\n"
    "\n"
    "// Maps every element through 'f' into a new Vec<U>.\n"
    "generic<T, U>\n"
    "struct Vec<U> vec_map(const &Vec<T> v, fn U(const &T) f) {\n"
    "    struct Vec<U> out = Vec::with_cap(v.len);\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < v.len) { out.push(f(&v.data[i])); i = i + 1UL; }\n"
    "    }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "} // namespace std\n"
    "\n"
    "#pragma scc_impl <std/collections/vec.sc>\n";
}

const char* g_vfs_35() {
    return
    "#pragma once\n"
    "// SafeC Standard Library — compile-time orderings\n"
    "//\n"
    "// An ordering is a type with 'int cmp(const &T a, const &T b) const'\n"
    "// returning <0, 0 or >0 — the Order trait below. Containers and algorithms\n"
    "// take the ordering as a type parameter bounded by Order\n"
    "// (BST<K, V, C: Order>, vec_sort_by(&v, ord)), so a type without cmp is\n"
    "// rejected where it is named, and after monomorphization each comparison is\n"
    "// a direct call the optimizer inlines — no function pointer, no per-compare\n"
    "// indirect call. FnOrder<T> wraps a runtime function pointer for orderings\n"
    "// only known at run time; any struct of your own with a cmp method is an\n"
    "// Order too.\n"
    "//\n"
    "//   struct BST<int, int, Less<int>> t = std::BST::new();     // natural order, inlined\n"
    "//   std::vec_sort_by(&v, std::FnOrder::of(by_name));         // runtime comparator\n"
    "\n"
    "#include <std/erased.h>\n"
    "\n"
    "namespace std {\n"
    "\n"
    "// Stands for \"the element type\" in trait signatures here and in\n"
    "// std/collections/traits.h: a trait fixes each method's name, static-ness\n"
    "// and parameter count; the parameter types are each implementation's own\n"
    "// (Erased: any type, see std/erased.h).\n"
    "typedef Erased Elem_;\n"
    "\n"
    "trait Order {\n"
    "    // <0 if a sorts before b, 0 if they are equivalent, >0 if after.\n"
    "    int cmp(const &Elem_ a, const &Elem_ b) const;\n"
    "}\n"
    "\n"
    "// Ascending by '<' / '>' (integers, floats, enums, pointers).\n"
    "generic<T>\n"
    "struct Less {\n"
    "    int unused_;\n"
    "    static struct Less<T> new();\n"
    "    int cmp(const &T a, const &T b) const;\n"
    "};\n"
    "\n"
    "generic<T>\n"
    "int Less::cmp(const &T a, const &T b) const { return *a < *b ? -1 : (*a > *b ? 1 : 0); }\n"
    "\n"
    "// Descending.\n"
    "generic<T>\n"
    "struct Greater {\n"
    "    int unused_;\n"
    "    static struct Greater<T> new();\n"
    "    int cmp(const &T a, const &T b) const;\n"
    "};\n"
    "\n"
    "generic<T>\n"
    "int Greater::cmp(const &T a, const &T b) const { return *a > *b ? -1 : (*a < *b ? 1 : 0); }\n"
    "\n"
    "// A comparator chosen at run time.\n"
    "generic<T>\n"
    "struct FnOrder {\n"
    "    fn int(const &T, const &T) f;\n"
    "    static struct FnOrder<T> of(fn int(const &T, const &T) f);\n"
    "    int cmp(const &T a, const &T b) const;\n"
    "};\n"
    "\n"
    "generic<T>\n"
    "int FnOrder::cmp(const &T a, const &T b) const { return self.f(a, b); }\n"
    "\n"
    "generic<T>\n"
