    "// Return wall-clock time in nanoseconds since the Unix epoch.\n"
    "// Same clock as time_wall_ns() (time.h).  Returns -1 on error.\n"
    "inline long long sys_time_now_ns() {\n"
    "    return time_wall_ns();\n"
    "}\n"
    "\n"
    "// Return a monotonic timestamp in nanoseconds (suitable for elapsed-time\n"
    "// measurement; epoch is unspecified).  Returns -1 on error.\n"
    "inline long long sys_monotonic_ns() {\n"
    "    return time_mono_ns();\n"
    "}\n"
    "\n"
    "// ── Process control ───────────────────────────────────────────────────────────\n"
    "\n"
    "// Run a shell command and return its exit status.  NULL → check if shell available.\n"
    "inline int sys_system(const &char cmd) {\n"
    "    unsafe { return system(cmd); }\n"
    "}\n"
    "\n"
    "// Register a function to be called at normal process exit.\n"
    "// Returns 0 on success, non-zero if the registration limit is exceeded.\n"
    "inline int sys_atexit(fn void() func) {\n"
    "    unsafe { return atexit(func); }\n"
    "}\n"
    "\n"
    "// ── PRNG ──────────────────────────────────────────────────────────────────────\n"
    "\n"
    "// Return a pseudo-random integer in [0, RAND_MAX].\n"
    "inline int sys_rand() {\n"
    "    unsafe { return rand(); }\n"
    "}\n"
    "\n"
    "// Seed the PRNG.  Use sys_time_now_ns() for a time-based seed.\n"
    "inline void sys_srand(unsigned int seed) {\n"
    "    unsafe { srand(seed); }\n"
    "}\n"
    "\n"
    "// ── Integer arithmetic ────────────────────────────────────────────────────────\n"
    "\n"
    "// Absolute value of a 32-bit signed integer.\n"
    "inline int sys_abs(int x) {\n"
    "    if (x < 0) { return -x; }\n"
    "    return x;\n"
    "}\n"
    "\n"
    "// Absolute value of a 64-bit signed integer.\n"
    "inline long long sys_llabs(long long x) {\n"
    "    if (x < 0LL) { return -x; }\n"
    "    return x;\n"
    "}\n"
    "\n"
    "// ── String → number conversions ───────────────────────────────────────────────\n"
    "\n"
    "// Convert a decimal string to int.  Stops at the first non-digit.\n"
    "inline int sys_atoi(const &char s) {\n"
    "    unsafe { return atoi(s); }\n"
    "}\n"
    "\n"
    "// Convert a decimal string to long long.\n"
    "inline long long sys_atoll(const &char s) {\n"
    "    unsafe { return atoll(s); }\n"
    "}\n"
    "\n"
    "// Convert a decimal/scientific string to double.\n"
    "inline double sys_atof(const &char s) {\n"
    "    unsafe { return atof(s); }\n"
    "}\n"
    "\n"
    "// Convert string to long long with explicit base (0 = auto-detect 0x/0 prefix).\n"
    "inline long long sys_strtoll(const &char s, ?&&const char end, int base) {\n"
    "    unsafe {\n"
    "        char* e = (char*)0;\n"
    "        long long v = strtoll(s, &e, base);\n"
    "        match (end) { case some(out): { *out = e; } case null: { } }\n"
    "        return v;\n"
    "    }\n"
    "}\n"
    "\n"
    "// Convert string to unsigned long long.\n"
    "inline unsigned long long sys_strtoull(const &char s, ?&&const char end, int base) {\n"
    "    unsafe {\n"
    "        char* e = (char*)0;\n"
    "        unsigned long long v = strtoull(s, &e, base);\n"
    "        match (end) { case some(out): { *out = e; } case null: { } }\n"
    "        return v;\n"
    "    }\n"
    "}\n"
    "\n"
    "// Convert string to double.\n"
    "inline double sys_strtod(const &char s, ?&&const char end) {\n"
    "    unsafe {\n"
    "        char* e = (char*)0;\n"
    "        double v = strtod(s, &e);\n"
    "        match (end) { case some(out): { *out = e; } case null: { } }\n"
    "        return v;\n"
    "    }\n"
    "}\n"
    "\n"
    "// Convert string to float.\n"
    "inline float sys_strtof(const &char s, ?&&const char end) {\n"
    "    unsafe {\n"
    "        char* e = (char*)0;\n"
    "        float v = strtof(s, &e);\n"
    "        match (end) { case some(out): { *out = e; } case null: { } }\n"
    "        return v;\n"
    "    }\n"
    "}\n"
    "\n"
    "// ── Sorting and searching ─────────────────────────────────────────────────────\n"
    "\n"
    "// Sort n elements of elem_size bytes in place.\n"
    "// cmp(a, b) compares two elements (int cmp(const T*, const T*), erased).\n"
    "inline void sys_qsort_raw_(unsigned char* base, unsigned long n, unsigned long elem_size, SysCmpRaw_ cmp) {\n"
    "    unsafe { qsort(base, n, elem_size, cmp); }\n"
    "}\n"
    "\n"
    "// Binary search in sorted array.  Returns pointer to match or NULL.\n"
    "const unsigned char* sys_bsearch_raw_(const &Erased key, const unsigned char* base,\n"
    "                                      unsigned long n, unsigned long elem_size, SysCmpRaw_ cmp) {\n"
    "    unsafe { return bsearch(key, base, n, elem_size, cmp); }\n"
    "}\n"
    "\n"
    "} // namespace std\n";
}

const char* g_vfs_60() {
    return
    "#pragma once\n"
    "// SafeC Standard Library — Time (comprehensive C11 <time.h>)\n"
    "// Complements sys.h (which covers high-resolution clocks).\n"
    "\n"
    "// Opaque time value: seconds since Unix epoch (1970-01-01 00:00:00 UTC).\n"
    "// Returned by time_now().\n"
    "namespace std {\n"
    "\n"
    "long long time_now();\n"
    "\n"
    "// Broken-down calendar time (C's struct tm fields, in the same order).\n"
    "struct TimeFields {\n"
    "    int sec;     // 0-60\n"
    "    int min;     // 0-59\n"
    "    int hour;    // 0-23\n"
    "    int mday;    // 1-31\n"
    "    int mon;     // 0-11\n"
    "    int year;    // years since 1900\n"
    "    int wday;    // 0 = Sunday\n"
    "    int yday;    // 0-365\n"
    "    int isdst;   // > 0 daylight saving, 0 not, < 0 unknown\n"
    "};\n"
    "\n"
    "// A Unix timestamp as broken-down UTC time.\n"
    "struct TimeFields time_gmtime(long long t);\n"
    "\n"
    "// A Unix timestamp as broken-down local time.\n"
    "struct TimeFields time_localtime(long long t);\n"
    "\n"
    "// Formats tm into buf with a strftime format string. Returns the number of\n"
    "// bytes written (0 on failure or when buf is too small).\n"
    "unsigned long time_format([]char buf, const &char fmt, const &TimeFields tm);\n"
    "\n"
    "// Parses a time string with strptime (POSIX) into *tm.\n"
    "// Returns 1 on success, 0 on failure (and on Windows).\n"
    "int time_parse(const &char s, const &char fmt, &TimeFields tm);\n"
    "\n"
    "// Converts broken-down local time back to a Unix timestamp (-1 on error).\n"
    "long long time_mktime(const &TimeFields tm);\n"
    "\n"
    "// Difference in seconds between two timestamps.\n"
    "double time_diff(long long end, long long start);\n"
    "\n"
    "// Wall-clock time in nanoseconds (CLOCK_REALTIME).\n"
    "long long time_wall_ns();\n"
    "\n"
    "// Monotonic clock in nanoseconds (CLOCK_MONOTONIC) — for elapsed time.\n"
    "long long time_mono_ns();\n"
    "\n"
    "// Process CPU time in nanoseconds (CLOCK_PROCESS_CPUTIME_ID).\n"
    "long long time_cpu_ns();\n"
    "\n"
    "// Elapsed nanoseconds between two mono timestamps.\n"
    "long long time_elapsed_ns(long long start, long long end);\n"
    "\n"
    "// Convert nanoseconds to milliseconds.\n"
    "double time_ns_to_ms(long long ns);\n"
    "\n"
    "// Sleep for nanoseconds (high precision).\n"
    "void time_sleep_ns(long long ns);\n"
    "\n"
    "// Days in a given month (month 0-11, year = actual year e.g. 2024).\n"
    "int time_days_in_month(int month, int year);\n"
    "\n"
    "// Return 1 if year is a leap year, 0 otherwise.\n"
    "int time_is_leap(int year);\n"
    "\n"
    "} // namespace std\n"
    "\n"
    "#pragma scc_impl <std/time.sc>\n";
