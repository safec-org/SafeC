    "\n"
    "} // namespace std\n"
    "\n"
    "// stdshim/mem.h.sc — playground implementation of <std/mem.h>'s out-of-line\n"
    "// functions on top of the scc runtime allocator (appended to the header).\n"
    "namespace std {\n"
    "\n"
    "unsigned long checked_mul_size(unsigned long a, unsigned long b) {\n"
    "    if (a != 0UL && b > 18446744073709551615UL / a) { abort(); }\n"
    "    return a * b;\n"
    "}\n"
    "unsigned long checked_add_size(unsigned long a, unsigned long b) {\n"
    "    if (a + b < a) { abort(); }\n"
    "    return a + b;\n"
    "}\n"
    "unsigned long mem_align_up(unsigned long addr, unsigned long align) {\n"
    "    return (addr + align - 1UL) & ~(align - 1UL);\n"
    "}\n"
    "unsigned long mem_align_down(unsigned long addr, unsigned long align) {\n"
    "    return addr & ~(align - 1UL);\n"
    "}\n"
    "int mem_is_aligned(unsigned long addr, unsigned long align) {\n"
    "    return (addr & (align - 1UL)) == 0UL;\n"
    "}\n"
    "int mem_fits_page(unsigned long addr, unsigned long size) {\n"
    "    return (addr & 4095UL) + size <= 4096UL;\n"
    "}\n"
    "void* alloc_raw_(unsigned long size) { return malloc(size); }\n"
    "void* alloc_zeroed_raw_(unsigned long size) { return calloc(1UL, size); }\n"
    "void dealloc_raw_(void* ptr) { free(ptr); }\n"
    "void* realloc_buf_raw_(void* ptr, unsigned long new_size) { return realloc(ptr, new_size); }\n"
    "void* realloc_array_raw_(void* ptr, unsigned long count, unsigned long elemSize) {\n"
    "    return realloc(ptr, checked_mul_size(count, elemSize));\n"
    "}\n"
    "void safe_memcpy_raw_(void* dst, const void* src, unsigned long n) { memcpy(dst, src, n); }\n"
    "void safe_memmove_raw_(void* dst, const void* src, unsigned long n) { memmove(dst, src, n); }\n"
    "void safe_memset_raw_(void* ptr, int val, unsigned long n) { memset(ptr, val, n); }\n"
    "int safe_memcmp_raw_(const void* a, const void* b, unsigned long n) { return memcmp(a, b, n); }\n"
    "void mem_prefetch_raw_(const void* addr, int write, int locality) { }\n"
    "void mem_zero_secure_raw_(void* ptr, unsigned long n) { memset(ptr, 0, n); }\n"
    "void mem_clflush_raw_(const void* addr) { }\n"
    "void* mem_align_ptr_raw_(void* ptr, unsigned long align) {\n"
    "    unsigned long a = 0UL;\n"
    "    unsafe { a = (unsigned long)ptr; }\n"
    "    unsigned long r = mem_align_up(a, align);\n"
    "    unsafe { return (void*)r; }\n"
    "}\n"
    "\n"
    "} // namespace std\n";
}

const char* g_vfs_13() {
    return
    "// SafeC Standard Library — Optional Panic System\n"
    "// Opt-in; does nothing unless panic_set_handler is called.\n"
    "// In freestanding mode defaults to infinite loop; hosted mode calls abort().\n"
    "#pragma once\n"
    "\n"
    "// Panic handler function type: fn(message, file, line) → noreturn\n"
    "namespace std {\n"
    "\n"
    "typedef fn void(const &char msg, const &char file, int line) PanicHandler;\n"
    "\n"
    "// Install a custom panic handler. Pass NULL to reset to default.\n"
    "void panic_set_handler(PanicHandler handler);\n"
    "\n"
    "// Trigger a panic with message, file, line.\n"
    "// Never returns.\n"
    "void panic_at(const &char msg, const &char file, int line);\n"
    "\n"
    "// Checked narrowing of a nullable reference: returns 'r' as '&T', or\n"
    "// panics with 'msg' if it is null. The explicit form of \"this can't be\n"
    "// null here\" — a cast '(&T)r' is rejected because it would skip the check.\n"
    "// For recoverable absence, 'match (r) { case null: ... case some(x): ... }'.\n"
    "generic<T>\n"
    "&T expect_ref(?&T r, const &char msg) {\n"
    "    match (r) {\n"
    "        case some(x): return x;\n"
    "        case null: { panic_at(msg, \"expect_ref\", 0); }\n"
    "    }\n"
    "    panic_at(msg, \"expect_ref\", 0);\n"
    "    return expect_ref(r, msg);   // unreachable: panic_at never returns\n"
    "}\n"
    "\n"
    "// Convenience macro.\n"
    "#ifdef __SAFEC_COMPAT_PREPROCESSOR__   // function-like macro: compat mode only\n"
    "#define PANIC(msg)  panic_at((msg), __FILE__, __LINE__)\n"
    "#endif\n"
    "\n"
    "// Assert that condition is true; panics with expression string if false.\n"
    "#ifdef __SAFEC_COMPAT_PREPROCESSOR__   // function-like macro: compat mode only\n"
    "#define PANIC_ASSERT(cond)  do { if (!(cond)) { PANIC(#cond); } } while(0)\n"
    "#endif\n"
    "\n"
    "} // namespace std\n"
    "\n"
    "// stdshim/panic.h.sc — playground implementation of <std/panic.h>: prints\n"
    "// \"panic at file:line: msg\" to stderr and exits 134, like the hosted std.\n"
    "namespace std {\n"
    "\n"
    "void* __scc_panic_handler_ = null;\n"
    "\n"
    "void panic_set_handler(PanicHandler handler) {\n"
    "    unsafe { __scc_panic_handler_ = (void*)handler; }\n"
    "}\n"
    "\n"
    "void panic_at(const &char msg, const &char file, int line) {\n"
    "    if (__scc_panic_handler_ != null) {\n"
    "        unsafe {\n"
    "            PanicHandler cb = (PanicHandler)__scc_panic_handler_;\n"
    "            cb(msg, file, line);\n"
    "        }\n"
    "    }\n"
    "    unsafe { fprintf(&__rt_files[2], \"panic at %s:%d: %s\\n\", file, line, msg); }\n"
    "    abort();\n"
    "}\n"
    "\n"
    "} // namespace std\n";
}

const char* g_vfs_14() {
    return
    "// SafeC Standard Library — Slice<T>: a bounds-checked view of T elements\n"
    "//\n"
    "//   int arr[8];\n"
    "//   struct Slice<int> s = std::Slice::of(&arr[0], 8UL);\n"
    "//   int third = s.get(2UL).default(0);\n"
    "//   struct Slice<int> mid = s.sub(2UL, 5UL);   // elements 2,3,4\n"
    "//\n"
    "// A Slice doesn't own its elements unless it came from Slice::alloc() (then\n"
    "// free() releases them). The arr_* helpers do the same bounds-checked work on\n"
    "// a bare (reference, length) pair.\n"
    "#pragma once\n"
    "#include <std/mem.h>\n"
    "#include <std/panic.h>\n"
    "\n"
    "namespace std {\n"
    "\n"
    "generic<T>\n"
    "struct Slice {\n"
    "    ?&T           ptr;   // first element; null for an empty slice\n"
    "    unsigned long len;   // element count\n"
    "\n"
    "    static struct Slice<T> of(&T first, unsigned long len);  // view of len elements at first\n"
    "    static struct Slice<T> alloc(unsigned long len);         // zeroed heap slice; empty on OOM\n"
    "\n"
    "    int             in_bounds(unsigned long idx) const;\n"
    "    ?&T             get(unsigned long idx) const;     // null if out of range\n"
    "    &T              at(unsigned long idx) const;      // panics if out of range\n"
    "    int             set(unsigned long idx, T val);    // 0 if out of range\n"
    "    struct Slice<T> sub(unsigned long start, unsigned long end) const; // [start, end); empty if invalid\n"
    "    unsigned long   length() const;\n"
    "    int             is_empty() const;\n"
    "    void            free();                            // only for Slice::alloc() slices\n"
    "};\n"
    "\n"
    "generic<T>\n"
    "struct Slice<T> Slice::of(&T first, unsigned long len) {\n"
    "    struct Slice<T> s;\n"
    "    s.ptr = first;\n"
    "    s.len = len;\n"
    "    return s;\n"
    "}\n"
    "\n"
    "// Zero-initialised heap slice of 'len' elements; empty (null) on OOM.\n"
    "generic<T>\n"
    "struct Slice<T> Slice::alloc(unsigned long len) {\n"
    "    struct Slice<T> s;\n"
    "    s.ptr = null;\n"
    "    s.len = 0UL;\n"
    "    ?&T p = null;\n"
    "    unsafe { p = (?&T)alloc_zeroed_raw_(checked_mul_size(len, sizeof(T))); }\n"
    "    if (!p.is_null()) { s.ptr = p; s.len = len; }\n"
    "    return s;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int Slice::in_bounds(unsigned long idx) const { return idx < self.len; }\n"
    "\n"
    "generic<T>\n"
    "?&T Slice::get(unsigned long idx) const {\n"
    "    if (idx >= self.len) return null;\n"
    "    match (self.ptr) {\n"
    "        case some(p): unsafe { return (?&T)&p[idx]; }\n"
    "        case null: { }\n"
    "    }\n"
    "    return null;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "&T Slice::at(unsigned long idx) const {\n"
    "    return expect_ref(self.get(idx), \"Slice::at: index out of range\");\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int Slice::set(unsigned long idx, T val) {\n"
    "    match (self.get(idx)) {\n"
    "        case some(e): { *e = val; return 1; }\n"
    "        case null: { }\n"
    "    }\n"
    "    return 0;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "struct Slice<T> Slice::sub(unsigned long start, unsigned long end) const {\n"
    "    struct Slice<T> out;\n"
    "    out.ptr = null;\n"
    "    out.len = 0UL;\n"
    "    if (start < end && end <= self.len) {\n"
    "        out.ptr = self.get(start);\n"
    "        out.len = end - start;\n"
    "    }\n"
    "    return out;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "unsigned long Slice::length() const { return self.len; }\n"
    "\n"
    "generic<T>\n"
    "int Slice::is_empty() const { return self.len == 0UL; }\n"
    "\n"
    "generic<T>\n"
    "void Slice::free() {\n"
    "    unsafe { dealloc_raw_((void*)self.ptr); }\n"
    "    self.ptr = null;\n"
    "    self.len = 0UL;\n"
    "}\n"
    "\n"
    "// ── Bounds-checked helpers on a (first element, length) pair ────────────────\n"
    "\n"
    "generic<T>\n"
    "?&T arr_at(&T first, unsigned long len, unsigned long idx) {\n"
    "    if (idx >= len) return null;\n"
    "    unsafe { return (?&T)&first[idx]; }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "int arr_set(&T first, unsigned long len, unsigned long idx, T val) {\n"
    "    if (idx >= len) return 0;\n"
    "    unsafe { first[idx] = val; }\n"
    "    return 1;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void arr_fill(&T first, unsigned long len, T val) {\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < len) { first[i] = val; i = i + 1UL; }\n"
    "    }\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void arr_copy(&T dst, const &T src, unsigned long len) {\n"
    "    unsafe {\n"
    "        unsigned long i = 0UL;\n"
    "        while (i < len) { dst[i] = src[i]; i = i + 1UL; }\n"
    "    }\n"
    "}\n"
    "\n"
    "// Smallest / largest element by '<'; null for an empty array.\n"
    "generic<T>\n"
    "?T arr_min(const &T first, unsigned long len) {\n"
    "    if (len == 0UL) return null;\n"
    "    T best = *first;\n"
    "    unsafe {\n"
    "        unsigned long i = 1UL;\n"
    "        while (i < len) { if (first[i] < best) best = first[i]; i = i + 1UL; }\n"
    "    }\n"
    "    return best;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "?T arr_max(const &T first, unsigned long len) {\n"
    "    if (len == 0UL) return null;\n"
    "    T best = *first;\n"
    "    unsafe {\n"
    "        unsigned long i = 1UL;\n"
    "        while (i < len) { if (first[i] > best) best = first[i]; i = i + 1UL; }\n"
    "    }\n"
    "    return best;\n"
    "}\n"
    "\n"
    "generic<T>\n"
    "void arr_reverse(&T first, unsigned long len) {\n"
    "    if (len < 2UL) return;\n"
    "    unsafe {\n"
    "        unsigned long lo = 0UL;\n"
    "        unsigned long hi = len - 1UL;\n"
    "        while (lo < hi) {\n"
    "            T tmp = first[lo];\n"
    "            first[lo] = first[hi];\n"
    "            first[hi] = tmp;\n"
    "            lo = lo + 1UL;\n"
    "            hi = hi - 1UL;\n"
    "        }\n"
    "    }\n"
    "}\n"
    "\n"
    "} // namespace std\n";
}

int vfs_add(int name, const char* text) {
    int n = lit_len(text);
    int start = g_src_len;
    int i = 0;
    while (i < n && g_src_len < SRC_MAX) { g_src[g_src_len] = (unsigned char)lit_char(text, i); g_src_len = g_src_len + 1; i = i + 1; }
    return add_file(name, start, n);
}

