// safec-doc — the page shell (scx: SafeC's JSX-style HTML templating).
//
// Templates only interpolate: {x} is HTML-escaped, {!x} is inserted raw
// (the fragments pages.sc prebuilt). Same chrome as the SafeC docs site:
// header with search and the theme toggle, sidebar, content, outline.
#include "doctool.h"

static const char* ICON_SEARCH() {
    return "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"m21 21-4.3-4.3M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z\"/></svg>";
}

static const char* ICON_THEME() {
    return "<svg class=\"sun\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\" fill=\"currentColor\"/><path stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4\"/></svg>"
           "<svg class=\"moon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z\"/></svg>";
}

static const char* ICON_REPO() {
    return "<svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14ZM8 7h8\"/></svg>";
}

static struct String header_(const &PageView v) {
    return <header class="vp-header">
        <div class="header-inner">
            <a class="brand" href={v.home_href.as_ptr()}><span class="crate-name">{v.crate_name.as_ptr()}</span><span class="crate-version">{v.version.as_ptr()}</span></a>
            <button class="search-btn" type="button" data-action="search" aria-label="Search"><span class="search-icon">{!ICON_SEARCH()}</span><span class="search-label">Search</span><kbd>/</kbd></button>
            <button class="icon-btn theme-toggle" type="button" data-action="theme" title="Toggle dark mode" aria-label="Toggle dark mode">{!ICON_THEME()}</button>
            <a class="icon-btn repo-link" href={v.repo.as_ptr()} rel="noreferrer" aria-label="Repository">{!ICON_REPO()}</a>
            <button class="icon-btn menu-toggle" type="button" data-action="menu" aria-label="Menu" aria-expanded="false" aria-controls="sidebar"><span class="burger"></span></button>
        </div>
    </header>;
}

static struct String search_() {
    return <div class="search-dialog" id="search" hidden role="dialog" aria-modal="true" aria-label="Search" data-empty="No results for">
        <div class="search-panel">
            <input class="search-input" type="search" autocomplete="off" spellcheck="false" placeholder="Search the API (name, path, kind)" aria-label="Search"/>
            <ul class="search-results" role="listbox"></ul>
            <p class="search-empty" hidden></p>
        </div>
    </div>;
}

static struct String body_(const &PageView v, const &String header, const &String search) {
    return <body class={v.page_class.as_ptr()} data-root={v.root.as_ptr()} data-copied="Copied">
        <a class="skip-link" href="#main">Skip to content</a>
        {!header.as_ptr()}
        <div class="sidebar-backdrop" data-action="menu"></div>
        <aside class="sidebar" id="sidebar"><nav class="sb-nav" aria-label="API">{!v.sidebar.as_ptr()}</nav></aside>
        <div class="layout">
            <main class="content" id="main">
                <div class="vp-doc">{!v.content.as_ptr()}</div>
            </main>
            <aside class="aside">
                <nav class="outline" aria-labelledby="outline-title">
                    <p class="outline-title" id="outline-title">On this page</p>
                    <ul class="toc">{!v.toc.as_ptr()}</ul>
                </nav>
            </aside>
        </div>
        {!search.as_ptr()}
        <script type="module" src={v.js.as_ptr()}></script>
    </body>;
}

static struct String document_(const &PageView v, const &String body) {
    // The inline script applies the saved/OS color scheme before first
    // paint (no flash); the wasm client toggles it afterwards.
    return <!doctype html>
    <html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width,initial-scale=1"/>
        <title>{v.title.as_ptr()}</title>
        <meta name="description" content={v.description.as_ptr()}/>
        <meta name="color-scheme" content="light dark"/>
        <meta name="generator" content="safec-doc"/>
        <link rel="stylesheet" href={v.css.as_ptr()}/>
        <script>(()=>{try{const t=localStorage.getItem('safec-theme');const d=t?t==='dark':matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.classList.toggle('dark',d)}catch(e){}})()</script>
    </head>
    {!body.as_ptr()}
    </html>;
}

struct String tpl_page(const &PageView v) {
    struct String header = header_(v);
    struct String search = search_();
    struct String body = body_(v, &header, &search);
    struct String doc = document_(v, &body);
    doc.push_char('\n');
    header.free(); search.free(); body.free();
    return doc;
}
