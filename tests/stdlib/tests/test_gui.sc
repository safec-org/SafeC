// std::gui, headless: drawing primitives, PNG decode, SVG, bitmap fonts and
// the widget pipeline (layout/render/dispatch), all into a RAM-backed
// GuiWindow. No windowing backend is linked: this file supplies
// gui_set_pixel itself (straight RGBA, like the framebuffer backend).
#include <std/test/test.h>
#include <std/mem.h>
#include <std/panic.h>
#include <std/str.h>
#include <std/gui/gui.h>
#include <std/gui/gui_draw.h>
#include <std/gui/gui_png.h>
#include <std/gui/gui_svg.h>
#include <std/gui/gui_font.h>
#include <std/gui/gui_widget.h>

namespace std {
void gui_set_pixel(&GuiWindow win, int x, int y, unsigned int rgba) {
    if (x < 0 || y < 0 || x >= win.width || y >= win.height) { return; }
    unsafe {
        unsigned long i = ((unsigned long)y * (unsigned long)win.width + (unsigned long)x) * 4UL;
        win.pixels[i + 0UL] = (unsigned char)((rgba >> 24) & 0xFFU);
        win.pixels[i + 1UL] = (unsigned char)((rgba >> 16) & 0xFFU);
        win.pixels[i + 2UL] = (unsigned char)((rgba >> 8) & 0xFFU);
        win.pixels[i + 3UL] = (unsigned char)(rgba & 0xFFU);
    }
}
}

static struct GuiWindow make_win(int w, int h) {
    struct GuiWindow win;
    win.platform = null;
    unsafe { win.pixels = (&heap unsigned char)alloc_zeroed_raw_((unsigned long)(w * h * 4)); }
    win.width = w;
    win.height = h;
    win.shouldClose = 0;
    return win;
}

static void free_win(&GuiWindow win) {
    unsafe { dealloc_raw_((void*)win.pixels); }
}

// Channel c (0=R .. 3=A) of pixel (x, y).
static int px(&GuiWindow win, int x, int y, int c) {
    unsafe { return (int)win.pixels[((unsigned long)y * (unsigned long)win.width + (unsigned long)x) * 4UL + (unsigned long)c]; }
}

static int count_red(&GuiWindow win) {
    int n = 0;
    int y = 0;
    while (y < win.height) {
        int x = 0;
        while (x < win.width) { if (px(win, x, y, 0) == 255 && px(win, x, y, 1) == 0) n = n + 1; x = x + 1; }
        y = y + 1;
    }
    return n;
}

